> flatMat  <- do.call(rbind, lapply(res, `[[`, "flat"))
> slopeMat <- do.call(rbind, lapply(res, `[[`, "slope"))
> effMat   <- do.call(rbind, lapply(res, `[[`, "effN"))
> nComp    <- vapply(res, `[[`, integer(1), "n")
