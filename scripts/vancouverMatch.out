+   dfG$longitude <- st_coordinates(dfG$centroid)[, 1]
+   dfG$latitude  <- st_coordinates(dfG$centroid)[, 2]
+   dfG$centroid  <- NULL
+   saveRDS(dfG, fGeo)
+ }
