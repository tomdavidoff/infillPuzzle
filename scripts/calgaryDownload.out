> 
> # CONFINE to single-family houses and rowhouses only. Use coded permitclass:
> # "single|detach" text matching wrongly swept in Private Detached Garage (5.8k)
> # and Two Family Semi-Detached. Single = 1106 Single Family House only.
> mp <- st_transform(ppt, 4326)
> mp$is_row_form[is.na(mp$is_row_form)] <- FALSE
> is_single <- grepl("Single Family House", mp$permitclass, ignore.case = TRUE)
> mp <- mp[mp$is_row_form %in% TRUE | is_single %in% TRUE, ]
> mp$cls <- ifelse(mp$is_row_form %in% TRUE, "Rowhouse", "Single")
> 
> # Drop outlier coordinates. A single bad geocode (e.g. 0,0) blows up st_bbox and
> # makes annotation_map_tile request a continent's worth of tiles -> render hangs.
> CAL_BOX <- c(xmin = -114.35, xmax = -113.80, ymin = 50.80, ymax = 51.25)
> co <- st_coordinates(mp)
> inbox <- co[, 1] >= CAL_BOX["xmin"] & co[, 1] <= CAL_BOX["xmax"] &
+          co[, 2] >= CAL_BOX["ymin"] & co[, 2] <= CAL_BOX["ymax"]
> cat(sprintf("  [bbox] dropped %d points outside Calgary\n", sum(!inbox)))
