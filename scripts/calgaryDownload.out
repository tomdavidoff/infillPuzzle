> # calgaryDownload.R
> # Replicates the Edmonton infill pipeline for Calgary's 2024 citywide R-CG rezoning.
> # 1. Downloads Calgary land-use (zoning) + building permits from the Socrata/SODA API
> #    into DropboxExternal/dataRaw, paging through ALL rows (not the 1k default cap).
> # 2. Builds census-tract gross-yield (rent/value "cap rate") gradient, as in
> #    edmontonCapRate.R, using 2021 StatCan tracts + spatially-joined assessed values.
> #
> # Calgary specifics vs Edmonton:
> #   - Projected CRS: EPSG:3780 (3TM 114W NAD83), NOT Edmonton's 3776.
> #   - Reform: citywide R-CG blanket upzoning effective 2024-08-06. REFORMYEAR <- 2024.
> #   - Base residential districts are the R-C* family (filter LU_CODE LIKE 'R-C%').
> #   - No multi-year assessment PANEL is published (unlike Edmonton), so the parent-lot
> #     linkage must lean on the land-use polygons + current assessed roll, not a
> #     demo-permit -> assessment-legal chain. Flagged at [PARENT-LOT LIMITATION] below.
> 
> suppressPackageStartupMessages({
+   library(data.table)
+   library(httr)
+   library(jsonlite)
+   library(sf)
+   library(cancensus)
+ })
> 
> ## ----------------------------------------------------------------------------
> ## CONFIG
> ## ----------------------------------------------------------------------------
> RAW      <- path.expand("~/DropboxExternal/dataRaw")   # adjust base if Dropbox root differs
> dir.create(RAW, recursive = TRUE, showWarnings = FALSE)
> 
> DOMAIN   <- "https://data.calgary.ca"
> # Land-use zoning: the Socrata view mw9j-jik5 is a map view whose /resource/ API
> # returns EMPTY records, so we pull from the ArcGIS FeatureServer it mirrors, which
> # serves attributes + geometry correctly.
> ZONING_FS <- paste0("https://services.arcgis.com/xYjDUN35YwdCEcMm/ArcGIS/rest/",
+                     "services/Land_Use_Districts/FeatureServer/0")
> PERMITS  <- "c2es-76ed"   # Building Permits (Socrata tabular API works fine)
> PAGE     <- 50000L        # SODA page size
> ARC_PAGE <- 2000L         # ArcGIS maxRecordCount is typically 1000-2000
> REFORMYEAR <- 2024
> CRS_PROJ <- 3780          # Calgary 3TM 114W NAD83
> CACHE    <- path.expand("~/Downloads/cancensusCache")
> dir.create(CACHE, recursive = TRUE, showWarnings = FALSE)
> options(cancensus.cache_path = CACHE)
> options(cancensus.api_key = "CensusMapper_4e1a1c2a1c23a336aec2ea4ce443330c")
> 
> APP_TOKEN <- Sys.getenv("SOCRATA_APP_TOKEN", "")
> 
> ## ----------------------------------------------------------------------------
> ## ArcGIS FeatureServer reader: pages features via resultOffset -> sf
> ## ----------------------------------------------------------------------------
> arc_fields <- function(fs) {
+   r <- GET(fs, query = list(f = "json")); stop_for_status(r)
+   meta <- fromJSON(content(r, "text", encoding = "UTF-8"))
+   meta$fields$name
+ }
> 
> arc_download <- function(fs, page = ARC_PAGE) {
+   # Ask for all attributes + geometry, GeoJSON out, paged by resultOffset.
+   qurl <- paste0(fs, "/query")
+   offset <- 0L; chunks <- list(); i <- 1L
+   repeat {
+     r <- GET(qurl, query = list(
+       where = "1=1", outFields = "*", outSR = "4326",
+       f = "geojson", resultOffset = offset, resultRecordCount = page))
+     stop_for_status(r)
+     part <- tryCatch(st_read(content(r, "text", encoding = "UTF-8"), quiet = TRUE),
+                      error = function(e) NULL)
+     if (is.null(part) || nrow(part) == 0L) break
+     chunks[[i]] <- part; i <- i + 1L
+     offset <- offset + page
+     cat(sprintf("    fetched %d features\n", offset))
+     if (nrow(part) < page) break   # last page
+   }
+   out <- do.call(rbind, chunks)
+   # ArcGIS polygons occasionally arrive as GEOMETRYCOLLECTION; extract polygons.
+   suppressWarnings(st_collection_extract(out, "POLYGON"))
+ }
> 
> ## ----------------------------------------------------------------------------
> ## SODA downloader: pages through the FULL dataset via $limit/$offset
> ## ----------------------------------------------------------------------------
> soda_headers <- function() if (nzchar(APP_TOKEN)) add_headers(`X-App-Token` = APP_TOKEN) else NULL
> 
> soda_count <- function(id) {
+   base <- sprintf("%s/resource/%s.json", DOMAIN, id)
+   r <- GET(base, query = list(`$select` = "count(1) as n"), soda_headers())
+   stop_for_status(r)
+   as.integer(fromJSON(content(r, "text", encoding = "UTF-8"))$n[1])
+ }
> 
> soda_fields <- function(id) {
+   # $limit=1 row reveals the actual field names at runtime -> no hardcoding Edmonton names
+   base <- sprintf("%s/resource/%s.json", DOMAIN, id)
+   r <- GET(base, query = list(`$limit` = 1), soda_headers())
+   stop_for_status(r)
+   names(fromJSON(content(r, "text", encoding = "UTF-8")))
+ }
> 
> soda_download <- function(id, dest, where = NULL) {
+   total <- soda_count(id)
+   cat(sprintf("  %s: %d rows to fetch\n", id, total))
+   offset <- 0L; parts <- list(); i <- 1L
+   base <- sprintf("%s/resource/%s.json", DOMAIN, id)
+   while (offset < total) {
+     # Pass params as a named query list so httr percent-encodes them (":id" -> "%3Aid").
+     q <- list(`$limit` = PAGE, `$offset` = offset, `$order` = ":id")
+     if (!is.null(where)) q[["$where"]] <- where
+     r <- GET(base, query = q, soda_headers()); stop_for_status(r)
+     chunk <- fromJSON(content(r, "text", encoding = "UTF-8"), flatten = TRUE)
+     if (length(chunk) == 0L || nrow(chunk) == 0L) break
+     parts[[i]] <- as.data.table(chunk); i <- i + 1L
+     offset <- offset + PAGE
+     cat(sprintf("    fetched %d / %d\n", min(offset, total), total))
+   }
+   dt <- rbindlist(parts, use.names = TRUE, fill = TRUE)
+   fwrite(dt, dest)
+   cat(sprintf("  wrote %s  (%d rows, %d cols)\n", dest, nrow(dt), ncol(dt)))
+   dt
+ }
> 
