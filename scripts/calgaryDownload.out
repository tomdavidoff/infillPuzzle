> ## ----------------------------------------------------------------------------
> ## 2. CENSUS-TRACT PRICE/RENT GRADIENT  (mirrors edmontonCapRate.R)
> ##    Gross yield = median rent*12 / median value, regressed on log value across
> ##    Calgary CMA (CMA 48825) 2021 census tracts. Expect beta well below 1.
> ## ----------------------------------------------------------------------------
> cat("\n=== TRACT PRICE/RENT GRADIENT ===\n")

=== TRACT PRICE/RENT GRADIENT ===
> ct <- get_census(
+   dataset = "CA21", regions = list(CMA = "48825"), level = "CT",
+   vectors = c(val = "v_CA21_4312",   # median value of dwellings
+               rent = "v_CA21_4318"), # median monthly shelter cost, rented
+   geo_format = "sf", quiet = TRUE
+ )
> setDT(ct)
> ct <- ct[val > 0 & rent > 0]
> ct[, caprate := (rent * 12) / val]
> ct[, lval := log(val)]
> 
> m_census <- lm(log(caprate) ~ lval, data = ct)
> cat(sprintf("[G1] OLS (census value)   beta = % .3f  (t vs 0: % .1f)\n",
+             coef(m_census)[2], summary(m_census)$coef[2, 3]))
[G1] OLS (census value)   beta = -0.772  (t vs 0: -25.9)
> b <- coef(m_census)[2]; se <- summary(m_census)$coef[2, 2]
> cat(sprintf("[G2] test beta = 1        t   = % .1f  (reject flat-yield null if < -2)\n",
+             (b - 1) / se))
[G2] test beta = 1        t   = -59.5  (reject flat-yield null if < -2)
> 
> # [PARENT-LOT LIMITATION] To add the assessed-value estimator (as in Edmonton's
> # OLS-assessed and IV specs), spatially join Calgary's current assessed-value roll
> # to these CT polygons in EPSG:3780 and aggregate a tract median, then rerun with
> # that as the RHS (OLS) and as an instrument (IV). The roll download is a third
> # Socrata dataset (Assessments) — add its 4-char id above and reuse soda_download().
> # Calgary publishes no multi-year account panel, so the demo->parent-legal linkage
> # used in Edmonton is not reconstructable here; parent-lot area must come from the
> # land-use polygon geometry via st_area() joined to permit points.
> 
> cat("\nDONE with cap-rate gradient.\n")

DONE with cap-rate gradient.
> 
> ## ----------------------------------------------------------------------------
> ## 3. ROWHOUSE PERMIT SHARE (eligible period) ON VALUE / RENT
> ##    Tract-level share of post-reform residential permits that are rowhouse-type,
> ##    regressed on log value, log rent, and both. Two numerators:
> ##      (a) built-form   : workclass/description/housingunits indicate rowhouse
> ##      (b) R-CG spatial : permit point falls in an R-CG land-use polygon
> ## ----------------------------------------------------------------------------
> cat("\n=== ROWHOUSE SHARE REGRESSIONS ===\n")

=== ROWHOUSE SHARE REGRESSIONS ===
> REFORM_DATE <- as.Date("2024-08-06")   # blanket R-CG upzoning takes effect
> REPEAL_DATE <- as.Date("2026-08-04")   # repeal takes effect; window closes here
> 
> # Permits -> sf on lon/lat, restricted to the ELIGIBLE WINDOW [reform, repeal).
> # NOTE: Calgary's data contains rows geocoded to (0,0) -- these are NOT NA, so they
> # survive an is.na() check and then wreck any bbox/spatial join. Drop them here.
> pp <- permits[!is.na(latitude) & !is.na(longitude) &
+               latitude  >  50.5 & latitude  <  51.5 &
+               longitude > -114.5 & longitude < -113.5]
> cat(sprintf("[R0a] dropped %d permits with bad/zero coordinates\n",
+             nrow(permits[!is.na(latitude) & !is.na(longitude)]) - nrow(pp)))
[R0a] dropped 926 permits with bad/zero coordinates
> pp[, issued := as.Date(substr(issueddate, 1, 10))]
> pp <- pp[!is.na(issued) & issued >= REFORM_DATE & issued < REPEAL_DATE]
> cat("[R0] eligible-window permits w/ coords:", nrow(pp), "\n")
[R0] eligible-window permits w/ coords: 45819 
> 
> pp_sf <- st_as_sf(pp, coords = c("longitude", "latitude"), crs = 4326)
> 
> # Residential denominator: permitclassgroup / permittypemapped flag residential.
> # (Field values printed in V-block; adjust the grepl if Calgary's labels differ.)
> is_resid <- grepl("resid", pp_sf$permitclassgroup, ignore.case = TRUE) |
+             grepl("resid", pp_sf$permitclassmapped, ignore.case = TRUE)
> pp_sf <- pp_sf[is_resid, ]
> cat("[R1] residential eligible permits    :", nrow(pp_sf), "\n")
[R1] residential eligible permits    : 44120 
> 
> # --- Print the real workclass / permittype vocabulary so the new-build match is
> #     against actual labels, not guessed ones (as with the zoning fields). ---
> cat("[R1a] workclass values:",
+     paste(sort(unique(na.omit(pp_sf$workclass))), collapse = " | "), "\n")
[R1a] workclass values: Addition | Alteration | Demolition | Fire/ Security Alarm | New | Repair | Temporary 
> cat("[R1b] permittype values:",
+     paste(sort(unique(na.omit(pp_sf$permittype))), collapse = " | "), "\n")
[R1b] permittype values: Commercial / Multi Family Project | Demolition | Residential Improvement Project | Single Construction Permit 
> 
> # --- SAMPLE SCREEN (applied as a UNION at [R3c], after $/sqft is available). ---
> # NEWBUILD flag: workclass indicates new construction. Adjust terms once [R1a] is
> # seen; Calgary typically uses "New" / "New Construction" in workclass/workclassmapped.
> newbuild <- grepl("new", pp_sf$workclass,        ignore.case = TRUE) |
+             grepl("new", pp_sf$workclassmapped,  ignore.case = TRUE)
> pp_sf$is_newbuild <- newbuild
> cat("[R1c] new-build permits              :", sum(newbuild, na.rm = TRUE), "\n")
[R1c] new-build permits              : 22726 
> # Do NOT subset here: the cost screen needs $/sqft (post-join), and we want
> # newbuild OR cost>=p50, so a non-new permit with high $/sqft must survive to [R3c].
> 
> # (a) Built-form rowhouse numerator. Use the CODED permitclass field, not free
> #     text: workclass has no dwelling-type category (Addition/Alteration/New/...),
> #     and description matching is unreliable. Rowhouse = Rhs Rowhouse + Ths Townhouse.
> form_row <- grepl("Rowhouse|Townhouse", pp_sf$permitclass, ignore.case = TRUE) &
+            !grepl("Accessory", pp_sf$permitclass, ignore.case = TRUE)
> pp_sf$is_row_form <- form_row
> cat("[R2] rowhouse/townhouse permits      :", sum(form_row, na.rm = TRUE), "\n")
[R2] rowhouse/townhouse permits      : 1621 
> 
> # (b) Zoning numerator: permit falls in a restored low-density R-C district.
> # NOTE: the ArcGIS layer is the POST-REPEAL (restored) snapshot, so R-C1/R-C2 are
> # the ex-post restored low-density districts, and surviving R-CG parcels are those
> # that redeveloped during the window (selected on outcome — see caveat in reply).
> # We flag the full R-C* family, not R-CG alone.
> zt   <- st_transform(zoning_sf, CRS_PROJ)
> ppt  <- st_transform(pp_sf,   CRS_PROJ)
> ppt$.pid <- seq_len(nrow(ppt))
> jj   <- st_join(ppt[, ".pid"], zt[, lu_col], join = st_within)
> jdt  <- as.data.table(st_drop_geometry(jj))
> jdt[, rc := grepl("^R-?C", get(lu_col), ignore.case = TRUE)]   # R-C1/R-C2/R-CG/...
> row_by_pid <- jdt[, .(is_row_zone = any(rc, na.rm = TRUE)), by = .pid]
> ppt <- merge(ppt, row_by_pid, by = ".pid", all.x = TRUE)
> ppt$is_row_zone[is.na(ppt$is_row_zone)] <- FALSE
> cat("[R3] permits in restored R-C* polygons:", sum(ppt$is_row_zone, na.rm = TRUE), "\n")
[R3] permits in restored R-C* polygons: 11038 
> 
> # --- SAMPLE SCREEN (UNION): keep a permit if it is a new build OR its cost/sqft is
> #     at/above the median $/sqft of new-builds-in-R-C*. Threshold is set on the
> #     new-build-in-R-C* set; the OR then also admits high-$/sqft non-new permits. ---
> ppt$cost   <- suppressWarnings(as.numeric(ppt$estprojectcost))
> ppt$sqft   <- suppressWarnings(as.numeric(ppt$totalsqft))
> ppt$cpsf   <- ifelse(ppt$sqft > 0, ppt$cost / ppt$sqft, NA_real_)
> rc_new     <- ppt$is_newbuild %in% TRUE & ppt$is_row_zone %in% TRUE &
+               is.finite(ppt$cpsf) & ppt$cpsf > 0
> thr        <- as.numeric(stats::median(ppt$cpsf[rc_new], na.rm = TRUE))
> cat(sprintf("[R3b] new-build-in-R-C* $/sqft p50 = %.1f  (n priced = %d)\n",
+             thr, sum(rc_new, na.rm = TRUE)))
[R3b] new-build-in-R-C* $/sqft p50 = 155.5  (n priced = 1181)
> 
> keep <- (ppt$is_newbuild %in% TRUE) | (is.finite(ppt$cpsf) & ppt$cpsf >= thr)
> n_pre <- nrow(ppt)
> ppt   <- ppt[keep, ]
> cat(sprintf("[R3c] sample after (new-build OR cost>=p50): %d  (of %d residential)\n",
+             nrow(ppt), n_pre))
[R3c] sample after (new-build OR cost>=p50): 22726  (of 44120 residential)
> 
> # Join permits to census tracts, aggregate to tract shares.
> # Guard the same one-to-many risk: a boundary point can match two tracts. Keep the
> # first match per permit (st_within on interior points is unique; ties are rare).
> ctp  <- st_transform(st_as_sf(ct), CRS_PROJ)          # ct has val/rent, geometry
> tj   <- st_join(ppt, ctp["GeoUID"], join = st_within)
> tj   <- as.data.table(st_drop_geometry(tj))
> tj   <- tj[, .SD[1], by = .pid]                       # one row per permit
> pdt  <- tj
> agg  <- pdt[!is.na(GeoUID), .(
+            n         = .N,
+            share_form = mean(is_row_form, na.rm = TRUE),
+            share_zone = mean(is_row_zone, na.rm = TRUE)
+          ), by = GeoUID]
> 
> reg  <- merge(agg, ct[, .(GeoUID, val, rent)], by = "GeoUID")
> reg  <- reg[val > 0 & rent > 0 & n >= 3]              # drop thin tracts
> reg[, `:=`(lval = log(val), lrent = log(rent))]
> cat("[R4] tracts in regression sample      :", nrow(reg), "\n")
[R4] tracts in regression sample      : 267 
> cat(sprintf("[R5] cor(lval, lrent) across tracts  : % .3f\n", cor(reg$lval, reg$lrent)))
[R5] cor(lval, lrent) across tracts  :  0.391
> cat("     (high |cor| => value/rent split in the joint spec is fragile)\n")
     (high |cor| => value/rent split in the joint spec is fragile)
> 
> run3 <- function(y, lbl) {
+   m_v  <- lm(reformulate("lval",          y), data = reg)
+   m_r  <- lm(reformulate("lrent",         y), data = reg)
+   m_vr <- lm(reformulate(c("lval","lrent"), y), data = reg)
+   cat(sprintf("\n-- %s --\n", lbl))
+   cat(sprintf("  on log value        : b_val = % .3f (t % .1f)\n",
+               coef(m_v)["lval"],  summary(m_v)$coef["lval","t value"]))
+   cat(sprintf("  on log rent         : b_rent= % .3f (t % .1f)\n",
+               coef(m_r)["lrent"], summary(m_r)$coef["lrent","t value"]))
+   cat(sprintf("  on both  b_val= % .3f (t % .1f) | b_rent= % .3f (t % .1f)\n",
+               coef(m_vr)["lval"],  summary(m_vr)$coef["lval","t value"],
+               coef(m_vr)["lrent"], summary(m_vr)$coef["lrent","t value"]))
+   list(v = m_v, r = m_r, vr = m_vr)
+ }
