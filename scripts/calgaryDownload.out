+             sum(mp$cls == "Single"), sum(mp$cls == "Rowhouse"), nrow(mp)))
  single: 9369   rowhouse: 1461   (total plotted 10830)
> 
> outdir  <- "text"; dir.create(outdir, showWarnings = FALSE)   # relative to project dir
> map_png <- file.path(outdir, "calgary_rowhouse_map.png")
> 
> # geom_sf builds a grob per feature and is very slow at this point count.
> # Pull the lon/lat out once and use geom_point instead.
> xy <- st_coordinates(mp)
> pd <- data.frame(lon = xy[, 1], lat = xy[, 2], cls = mp$cls)
> 
> # Keyless OSM street tiles (cartolight now needs a key under rosm >= 0.3).
> p <- ggplot() +
+   annotation_map_tile(type = "osm", zoomin = -1, progress = "none") +
+   geom_point(data = pd[pd$cls == "Single", ], aes(lon, lat, colour = cls),
+              size = 0.35, alpha = 0.35) +
+   geom_point(data = pd[pd$cls == "Rowhouse", ], aes(lon, lat, colour = cls),
+              size = 1.3, alpha = 0.95) +
+   coord_sf(xlim = st_bbox(mp)[c(1, 3)], ylim = st_bbox(mp)[c(2, 4)], crs = 4326) +
+   scale_colour_manual(values = c("Single"   = "#333333",
+                                  "Rowhouse" = "#e6194b"), name = NULL) +
+   guides(colour = guide_legend(override.aes = list(size = 3))) +
+   theme_minimal() +
+   labs(title = "Calgary eligible-window new builds: single vs rowhouse") +
+   theme(legend.position = "bottom", panel.grid = element_blank())
