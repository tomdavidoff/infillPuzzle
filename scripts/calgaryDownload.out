> ## ----------------------------------------------------------------------------
> ## 4b. TRACT CENTROIDS coloured by rent and by value, same basemap/extent.
> ##     Lets you eyeball the rent vs value gradients against where rowhouses go.
> ## ----------------------------------------------------------------------------
> # ct is the CT sf with val/rent; take centroids, clip to the map extent.
> ctc <- st_transform(st_as_sf(ct), 4326)
> ctc <- ctc[!is.na(ctc$val) & !is.na(ctc$rent), ]
> cxy <- st_coordinates(st_centroid(st_geometry(ctc)))
> cd  <- data.frame(lon = cxy[, 1], lat = cxy[, 2],
+                   val = ctc$val, rent = ctc$rent)
> bx  <- st_bbox(mp)
> cd  <- cd[cd$lon >= bx[1] & cd$lon <= bx[3] &
+           cd$lat >= bx[2] & cd$lat <= bx[4], ]
> cat(sprintf("  [centroids] %d tracts within map extent\n", nrow(cd)))
  [centroids] 286 tracts within map extent
> 
> tract_map <- function(var, lbl, file) {
+   # Colour by within-city percentile rank: raw values are right-skewed, so a
+   # linear scale buries nearly every tract at the dark end of viridis.
+   v  <- cd[[var]]
+   cd$pct <- rank(v, ties.method = "average") / length(v)
+   # Label the legend with the actual values at each decile break.
+   brks <- seq(0, 1, by = 0.25)
+   labs <- format(round(quantile(v, brks, na.rm = TRUE)), big.mark = ",")
+   g <- ggplot() +
+     annotation_map_tile(type = "osm", zoomin = -1, progress = "none") +
+     geom_point(data = cd, aes(lon, lat, colour = pct), size = 2.6, alpha = 0.9) +
+     coord_sf(xlim = bx[c(1, 3)], ylim = bx[c(2, 4)], crs = 4326) +
+     scale_colour_viridis_c(name = lbl, breaks = brks, labels = labs,
+                            limits = c(0, 1)) +
+     theme_minimal() +
+     labs(title = paste("Calgary census tract centroids:", lbl),
+          subtitle = "colour = within-city percentile; legend shows value at each quartile") +
+     theme(legend.position = "bottom", panel.grid = element_blank(),
+           legend.key.width = unit(2, "cm"))
+   ggsave(file.path(outdir, file), g, width = 10, height = 8, dpi = 150)
+   cat(sprintf("  wrote %s   [%s: min %s / med %s / max %s]\n",
+               file.path(outdir, file), var,
+               format(round(min(v, na.rm = TRUE)), big.mark = ","),
+               format(round(median(v, na.rm = TRUE)), big.mark = ","),
+               format(round(max(v, na.rm = TRUE)), big.mark = ",")))
+ }
> 
> tract_map("rent", "Median rent ($/mo)",     "calgary_tract_rent.png")
