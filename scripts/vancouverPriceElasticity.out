> # ---- does SFD elasticity predict the duplex - SFD gap? -----------------------
> print(out[, .(corGapElas = cor(gap, elas), corGapLevel = cor(gap, lppsfSFD),
+               corElasLevel = cor(elas, lppsfSFD), nAreas = .N)])
