> dtAM <- dtAM[`Assessment Year` == maxYear]
> 
> dtAM <- dtAM[!is.na(assessed) & assessed > 0 &
+              !is.na(gross)    & gross    > 0 &
+              !is.na(Longitude) & !is.na(Latitude)]
> dtAM[, appsf := assessed / gross]
> qa <- quantile(dtAM$appsf, c(0.01, 0.99), na.rm = TRUE)
> dtAM <- dtAM[appsf > qa[1] & appsf < qa[2]]
> 
> MAXAGE <- 50
