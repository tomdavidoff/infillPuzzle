> # ============================================================================
> # 6. Results
> # ============================================================================
> summFSR <- function(x) list(N = length(x), mean = round(mean(x), 3),
+                             p25 = round(quantile(x, .25), 3), p50 = round(median(x), 3),
+                             p75 = round(quantile(x, .75), 3))
